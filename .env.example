# Sentinela — environment variables
#
# Copy this file to `.env` (which is git-ignored) and fill in the values.
#   cp .env.example .env
#
# OpenRouteService API key — powers the real-roads "safe route" that avoids
# hazard zones. Get one free (~2 min) at:
#   https://openrouteservice.org/dev/#/signup
# Without it, the app falls back to the offline simulation.
ORS_API_KEY=
